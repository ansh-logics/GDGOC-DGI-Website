# MongoDB connection string
# For Docker Compose, use mongodb://mongo:27017/gdgoc_dgi
MONGO_CONNECTION=mongodb://localhost:27017/gdgoc_dgi

# JWT secret for signing/verifying auth tokens (required)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server port (optional, defaults to 3000 in code)
# The provided Docker Compose file pins this to 4000.
PORT=4000

# Cloudinary config (for image uploads)
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret
